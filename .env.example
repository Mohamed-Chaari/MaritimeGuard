# MaritimeGuard AI — environment variables
# Copy to .env and fill in secrets. .env is gitignored.

# Data lake (MinIO / S3)
MINIO_USER=admin
MINIO_PASSWORD=admin12345
S3_RAW_BUCKET=raw
S3_ENDPOINT=http://minio:9000

# Metadata DB
PG_USER=insight
PG_PASSWORD=insight
PG_DB=maritimeguard

# Semantic layer
CUBE_SECRET=devsecret

# BI
SUPERSET_SECRET=devsecretkey

# GenAI "Ask Your Data" + AI Briefings (serving/api/ask_data.py, briefing.py)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Digitraffic.fi AIS feed (optional, increases rate limit)
DIGITRAFFIC_USER=MaritimeGuardAI

# MarineCadastre AIS data path (local GeoParquet files)
AIS_DATA_DIR=./data/ais_raw
